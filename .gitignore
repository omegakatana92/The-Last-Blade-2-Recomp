# Build trees and generated recompiled C (derived from the user's ROMs)
build*/
generated/
entries*.txt

# ROMs and BIOS are never committed
roms/*
!roms/README.txt

# Release folders are produced by the packaging scripts
dist/

# Local test output
*.log
*.wav
*.mp4
*.png
!packaging/appimage/lastblade2.png
!docs/screenshots/*.png
